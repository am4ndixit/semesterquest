# Copy this file to .env before running the app.
# Replace this secret before exposing the app outside your own machine.
SQ_SECRET_KEY=replace-with-a-long-random-secret

# Development only: returns the one-time code in the browser response.
# In production, set DEV_SHOW_CODE=0 and configure SMTP below.
DEV_SHOW_CODE=1
SQ_OTP_MINUTES=10
SQ_ACCESS_TOKEN_MINUTES=10080
SQ_MAX_UPLOAD_MB=20
SQ_RUN_TIMEOUT=5
SQ_PYTHON_IMAGE=python:3.13-alpine

# SQLite is the default. PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://semester_quest:password@localhost:5432/semester_quest

# SMTP settings for real ADYPU mailbox verification:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password
# SMTP_FROM=Semester Quest <no-reply@example.com>

# Optional OpenAI-compatible tutor endpoint (Ollama / LM Studio / vLLM / OpenAI).
# For Ollama, use its OpenAI-compatible URL and a model you have pulled locally.
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=your-local-model-name

# Comma-separated frontend origins when using the Vite dev server.
SQ_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
