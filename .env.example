# ─────────────────────────────────────────────────────────────────────────────
# Semester Quest — Environment Variables
# Copy this to .env (cp .env.example .env) and fill in your keys.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
SQ_SECRET_KEY=change-this-to-a-random-64-char-string

# ── 🔥 Groq (FREE — ultra-fast AI) ───────────────────────────────────────────
# Sign up in 30 sec, no credit card: https://console.groq.com
# Free tier: ~14,400 req/day on llama3-8b-8192 ✅ RECOMMENDED
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
# Model options (all free): llama3-8b-8192 | llama3-70b-8192 |
#   mixtral-8x7b-32768 | gemma2-9b-it | llama-3.1-8b-instant
GROQ_MODEL=llama3-8b-8192

# ── Gemini AI (FREE — Google AI Studio) ──────────────────────────────────────
# Get key at: https://aistudio.google.com/app/apikey (no credit card)
# Free tier: 15 RPM / 1M TPM on gemini-1.5-flash
# Used as fallback if GROQ_API_KEY is not set
GEMINI_API_KEY=AIzaSy_xxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-1.5-flash

# ── Resend.com (FREE email) ───────────────────────────────────────────────────
# Sign up at https://resend.com → API Keys → Create
# Free tier: 100 emails/day, 3000/month — no credit card needed
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Use Resend's test "From" (works without domain verification in dev):
EMAIL_FROM=Semester Quest <onboarding@resend.dev>

# ── Google OAuth (FREE) ───────────────────────────────────────────────────────
# https://console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0
# Add authorised redirect URI: http://127.0.0.1:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx

# ── Optional: Custom LLM (Ollama / LM Studio / vLLM) ─────────────────────────
# Used only if GROQ_API_KEY and GEMINI_API_KEY are both empty
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3

# ── Database (local SQLite by default — no change needed for dev) ─────────────
# DATABASE_URL=sqlite:///./backend/data/semester_quest.db

# ── Dev helpers ───────────────────────────────────────────────────────────────
# Set DEV_SHOW_CODE=0 in production to hide OTP codes from API responses
DEV_SHOW_CODE=1
